# 로컬 비밀 설정 — Git에 포함하지 않습니다. 키를 대화에 붙여넣지 마세요.

# 실제 데이터를 사용할 때 입력할 서버 키 (발급 안내: API_KEY_SETUP.md)
# 발급한 값은 로컬 .env 또는 호스팅의 비밀 환경변수에 입력하세요.
AI_API_KEY=
NUTRITION_API_KEY=
PUBLIC_DATA_API_KEY=

# 해외 식당을 사용할 때만 입력
GOOGLE_PLACES_API_KEY=

# 한국의 실제 식당 및 위치 조회: Kakao REST API
KAKAO_REST_API_KEY=

# 서버 설정 / AI는 별도 전송 동의 후 사용
APP_ENV=development
DEMO_MODE=true
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
NUTRITION_PROVIDER=data_go_kr
NUTRITION_API_BASE_URL=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo03
NUTRITION_API_OPERATION=getFoodNtrCpntDbInq03
PUBLIC_DATA_RESTAURANT_BASE_URL=https://apis.data.go.kr/1741000/general_restaurants
PUBLIC_DATA_RESTAURANT_OPERATION=info

# 선택·예약 항목: 지금 발급할 필요 없음
DATA_ENCRYPTION_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
WEB_SEARCH_API_KEY=
MAP_BROWSER_KEY=
DATABASE_URL=
SESSION_SECRET=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=
